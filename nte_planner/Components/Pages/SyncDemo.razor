@page "/"

@using Microsoft.EntityFrameworkCore
@using nte_planner.Data
@using nte_planner.Models
@inject IDbContextFactory<AppDbContext> DbFactory
@inject Supabase.Client Supabase

<h3>Rarity Management (Local-First + Supabase Sync)</h3>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="SyncFromCloud">↓ Pull from Supabase</button>
    <button class="btn btn-warning" @onclick="SyncToCloud">↑ Push Local to Supabase</button>
</div>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="card mb-4">
        <div class="card-header">
            @(isEditing ? "Edit Rarity" : "Add New Rarity")
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-5">
                    <input class="form-control" @bind="currentRarity.Name" placeholder="Rarity Name (e.g. Legendary)" />
                </div>
                <div class="col-md-5">
                    <input class="form-control" @bind="currentRarity.ImageLink" placeholder="Image URL" />
                </div>
                <div class="col-md-2">
                    @if (isEditing)
                    {
                        <button class="btn btn-success w-100" @onclick="UpdateLocal">Save Changes</button>
                        <button class="btn btn-secondary w-100 mt-1" @onclick="CancelEdit">Cancel</button>
                    }
                    else
                    {
                        <button class="btn btn-success w-100" @onclick="CreateLocal">Add</button>
                    }
                </div>
            </div>
        </div>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Image URL</th>
                <th>Last Updated</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var rarity in localRarities)
            {
                <tr>
                    <td>@rarity.Id</td>
                    <td>@rarity.Name</td>
                    <td>@rarity.ImageLink</td>
                    <td>@rarity.LastUpdatedAt?.ToString("g")</td>
                    <td>
                        <button class="btn btn-sm btn-info" @onclick="() => EditLocal(rarity)">Edit</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteLocal(rarity)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Rarity> localRarities = new();
    private Rarity currentRarity = new();
    private bool isLoading = true;
    private bool isEditing = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadLocalData();
    }

    // ==========================================
    // 1. LOCAL SQLITE CRUD (Instant UI Updates)
    // ==========================================
    
    private async Task LoadLocalData()
    {
        isLoading = true;
        using var db = await DbFactory.CreateDbContextAsync();
        localRarities = await db.Rarities.ToListAsync();
        isLoading = false;
    }

    private async Task CreateLocal()
    {
        if (string.IsNullOrWhiteSpace(currentRarity.Name)) return;

        using var db = await DbFactory.CreateDbContextAsync();
        
        currentRarity.LastUpdatedAt = DateTime.UtcNow;
        db.Rarities.Add(currentRarity);
        await db.SaveChangesAsync();

        currentRarity = new Rarity(); // reset form
        await LoadLocalData();
    }

    private void EditLocal(Rarity rarity)
    {
        // Copy values so we don't accidentally edit the grid directly before saving
        currentRarity = new Rarity
        {
            Id = rarity.Id,
            Name = rarity.Name,
            ImageLink = rarity.ImageLink
        };
        isEditing = true;
    }

    private async Task UpdateLocal()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.Rarities.FindAsync(currentRarity.Id);
        if (existing != null)
        {
            existing.Name = currentRarity.Name;
            existing.ImageLink = currentRarity.ImageLink;
            existing.LastUpdatedAt = DateTime.UtcNow;
            await db.SaveChangesAsync();
        }

        CancelEdit();
        await LoadLocalData();
    }

    private void CancelEdit()
    {
        currentRarity = new Rarity();
        isEditing = false;
    }

    private async Task DeleteLocal(Rarity rarity)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        db.Rarities.Remove(rarity);
        await db.SaveChangesAsync();
        
        await LoadLocalData();
    }

    // ==========================================
    // 2. SUPABASE SYNC LOGIC
    // ==========================================

    private async Task SyncFromCloud()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            // 1. Fetch from Supabase
            var response = await Supabase.From<Rarity>().Get();
            var cloudRarities = response.Models;

            // 2. Overwrite Local SQLite with Cloud Data
            using var db = await DbFactory.CreateDbContextAsync();
            
            // For a basic demo, we clear and replace.
            // In a production app, you would do a smart merge based on 'LastUpdatedAt'
            var localData = await db.Rarities.ToListAsync();
            db.Rarities.RemoveRange(localData);
            await db.SaveChangesAsync();

            db.Rarities.AddRange(cloudRarities);
            await db.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Sync pull failed: {ex.Message}");
        }

        await LoadLocalData();
    }

    private async Task SyncToCloud()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var locals = await db.Rarities.ToListAsync();

            // Supabase allows bulk Upserting. It will match on the Primary Key (Id).
            await Supabase.From<Rarity>().Upsert(locals);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Sync push failed: {ex.Message}");
        }

        await LoadLocalData();
    }
}